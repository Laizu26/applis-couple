rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Seuls les deux membres du couple (vérifiés via le document Firestore correspondant)
    // peuvent lire ou écrire les fichiers chiffrés de ce couple (photos ET pièces jointes du chat).
    match /couples/{coupleId}/{subpath=**} {
      allow read, write: if request.auth != null &&
        (firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.user1Id == request.auth.uid ||
         firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.user2Id == request.auth.uid);
    }
  }
}
